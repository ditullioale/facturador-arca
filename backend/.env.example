# Base de datos
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/facturador

# Frontend permitido (CORS)
CORS_ORIGINS=http://localhost:5173

# Datos del emisor
ARCA_CUIT=20305903990
ARCA_PUNTO_VENTA=1
# 11 = Factura C (monotributo), 6 = Factura B, 1 = Factura A
ARCA_TIPO_COMPROBANTE=11
ARCA_CONCEPTO_DESCRIPCION=HONORARIOS PROFESIONALES
# Solo se factura cuando el importe SUPERA este mínimo (por debajo, se pregunta)
ARCA_IMPORTE_MINIMO=50000
# Consultar el padrón de ARCA (en homologación suele estar caído -> false para no esperarlo)
ARCA_CONSULTAR_PADRON=true

# mock | homologacion | produccion
ARCA_MODE=mock
ARCA_CERT_PATH=/ruta/certificado.crt
ARCA_KEY_PATH=/ruta/clave-privada.key
# Alternativa para la nube (Railway): certificado y clave en base64 (tienen prioridad
# sobre las rutas de arriba). Generarlos con:  base64 -w 0 archivo
ARCA_CERT_B64=
ARCA_KEY_B64=
# Carpeta donde se cachea el Ticket de Acceso (TA) entre reinicios (vacío = temporal del sistema)
ARCA_TA_DIR=

# Domicilio usado cuando el padron de ARCA no informa uno
DOMICILIO_DEFAULT=Arroyo Seco

# === Multiempresa ===
# Clave maestra para cifrar los certificados de cada emisor (setear SIEMPRE la misma;
# si la cambiás, los certificados guardados dejan de poder descifrarse).
FACTURADOR_SECRET=
# Token que protege el alta de emisores (POST /api/emisores). Lo usa el gestor.
FACTURADOR_ADMIN_TOKEN=
# Secreto compartido con el gestor para los pedidos que usan el emisor por defecto
# (header X-Integracion-Token). Mismo valor en el gestor. OBLIGATORIO fuera de mock.
FACTURADOR_INTEGRACION_TOKEN=

# Documentación interactiva (/docs, /redoc, /openapi.json). Apagada por defecto.
FACTURADOR_DOCS=0
# Tope del resumen bancario que se acepta subir, en MB.
FACTURADOR_MAX_UPLOAD_MB=10
